# Run artifacts. runs/ is unpacked from data/runs/*.tar.xz (python -m harness.unpack_runs);
# results/ is committed so every reported number is traceable.
/runs/
/runs_*/
/logs_*/

# Secrets — never commit an API key
.env
.env.*

# Python
.venv/
env/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
build/
dist/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
